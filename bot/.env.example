# Скопируйте этот файл в .env (рядом, в папке bot) и заполните.
# Строки с # — комментарии, их можно не трогать.

# ============ 1. ОБЯЗАТЕЛЬНО: Telegram-бот ============
# Токен от @BotFather: напишите ему /newbot и скопируйте строку целиком.
BOT_TOKEN=123456789:AAAA...
# Ваш личный Telegram ID (число). Узнать: напишите @userinfobot.
# Только этот ID станет владельцем и попадёт в бота первым.
OWNER_ID=

# ============ 2. ИИ (DeepSeek) ============
# Ключ из https://platform.deepseek.com → API keys. Начинается с sk-
# Без ключа бот работает, но лиды скорятся по эвристикам: без анализа, без черновиков, без чтения картинок.
AI_API_KEY=

# Эти две строки менять НЕ нужно — значения по умолчанию верные.
AI_BASE_URL=https://api.deepseek.com
# Сейчас у DeepSeek две модели: deepseek-flash (дешёвая, читает картинки) и deepseek-v4-pro (умнее, дороже,
# картинки не читает). Старые имена (deepseek-chat, deepseek-reasoner, deepseek-v4-flash) бот подменит сам.
AI_MODEL=deepseek-flash

# Чтение картинок из рекламных постов. Пустое поле = та же модель, что AI_MODEL.
# Поставьте off, чтобы полностью выключить зрение и не тратить на него деньги.
AI_VISION_MODEL=

# Цены за 1 млн токенов в $ — только для подсчёта расхода внутри бота (реальный счёт ведёт DeepSeek).
# Указаны пиковые тарифы deepseek-flash, чтобы лимит срабатывал заранее. Сверяйте на platform.deepseek.com/pricing
AI_PRICE_IN=0.30
AI_PRICE_CACHED=0.006
AI_PRICE_OUT=1.20
# Сколько секунд ждать ответ ИИ, прежде чем повторить запрос.
AI_TIMEOUT=90
# Режим размышления: 1 — точнее, но втрое дороже и медленнее. Для нашей задачи не нужен.
AI_THINKING=0

# Бот работает с любым OpenAI-совместимым API, не только с DeepSeek: поменяйте AI_BASE_URL, AI_MODEL,
# AI_API_KEY и цены на тарифы своего сервиса — остальной код трогать не нужно.

# ============ 3. Сканер каналов (можно заполнить позже) ============
# Нужен ОТДЕЛЬНЫЙ Telegram-аккаунт (не ваш личный: его могут ограничить за массовые вступления).
# Получить: my.telegram.org → API development tools.
# После заполнения один раз запустите: python login_scanner.py
TG_API_ID=
TG_API_HASH=

# ============ 4. Прочее ============
TZ=Europe/Moscow
DATA_DIR=data
# Ключ шифрования сохранённых API-ключей Trustat. Если пусто — создастся сам в data/.secret
# APP_SECRET=
